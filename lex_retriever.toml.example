# lex_retriever.toml.example
# Copy to lex_retriever.toml and adjust to your installation.
# Run `python -m lex_retriever list-available` for all available law codes.

[database]
# Path to LanceDB persistence directory (default: ./lancedb)
path = "./lancedb"

[laws]
# Laws to include in this installation.
# `index-all` will only index these; omit this section for the default set.
active = [
    "BGB",
    "HGB",
    "GMBHG",
    "DSGVO",
    "STGB",
    "ZPO",
]

[neuris]
# NeuRIS API (testphase.rechtsinformationen.bund.de) — public, no auth needed.
# transport: "testphase" (default) or "production" (not yet live, raises error).
transport = "testphase"
# If a future transport requires an API key, set the env-var name here:
# api_key_env = "NEURIS_API_KEY"   # then: export NEURIS_API_KEY=<your-key>

[cellar]
# EUR-Lex CELLAR — public SPARQL + HTML, no key needed for standard access.
# High-volume commercial access may require a key.
endpoint = "https://publications.europa.eu/webapi/rdf/sparql"
# api_key_env = "CELLAR_API_KEY"   # then: export CELLAR_API_KEY=<your-key>

[embedding]
# Embedding provider — controls how text is turned into vectors.
# Changing the provider requires a full re-index: python -m lex_retriever index-all --force

# --- Default: local, no API key needed, 128-token limit ---
provider = "sentence-transformers"
model = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# --- Mistral: better quality, 8 192-token limit ---
# pip install mistralai
# provider = "mistral"
# model = "mistral-embed"
# api_key_env = "MISTRAL_API_KEY"

# --- Google: free-tier API key available, 2 048-token limit ---
# pip install google-generativeai
# provider = "google"
# model = "text-embedding-004"
# api_key_env = "GOOGLE_API_KEY"
